{
  "name": "invocationofrights.org",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "gen-redirects": "node -r ts-node/register scripts/generate-redirects.cts",
    "deploy": "echo invocationofrights.org > out/CNAME && echo true > out/.nojekyll && gh-pages -d out -f -t",
    "build-deploy": "npm run gen-redirects && npm run build && npm run deploy"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "lucide-react": "^0.503.0",
    "next": "15.3.0",
    "qrcode-svg": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-gtm-module": "^2.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode-svg": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
